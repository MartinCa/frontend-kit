{
  "name": "@martinrun/frontend-config",
  "version": "0.2.2",
  "description": "Shared frontend conventions: ESLint, TypeScript and Prettier config for React + shadcn/ui projects.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartinCa/frontend-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format-check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,js,mjs,html}": [
      "prettier --write"
    ]
  },
  "exports": {
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js",
    "./tsconfig": "./tsconfig.base.json"
  },
  "files": [
    "eslint.config.js",
    "prettier.config.js",
    "tsconfig.base.json",
    "LICENSE"
  ],
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": ">=3",
    "prettier-plugin-tailwindcss": ">=0.6",
    "typescript": ">=5.5 <7"
  },
  "dependencies": {
    "@eslint/js": "^10.0.0",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3"
  }
}
